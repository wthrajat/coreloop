# Runtime. APP_ORIGIN must be the exact HTTPS Vercel origin in production.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
APP_TIME_ZONE=Asia/Kolkata
SESSION_SECRET=

# Turso/libSQL
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Telegram OIDC and bot delivery
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OWNER_TELEGRAM_SUBJECT=

# Signed scheduling and queue wake-ups
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_TOKEN=

# AI providers. Scheduled work never falls back to OpenAI automatically.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Content-free owner alerts. SMTP is optional but required to send email.
ADMIN_ALERT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
